# Copy this file to ".env" and fill in your own values. Never commit ".env".

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quote_wall_dev"

# Secret used to SIGN and VERIFY JWTs. Anyone who knows it can forge logins,
# so make it long and random, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# How long a token stays valid (jsonwebtoken format: "15m", "2h", "7d" ...)
JWT_EXPIRES_IN="7d"

# The exact origin of the React app. CORS only allows requests from here.
# (No trailing slash!)  Local: http://localhost:5173
CLIENT_ORIGIN="http://localhost:5173"

# Port the API listens on (Render sets PORT for you in production).
PORT=4000
